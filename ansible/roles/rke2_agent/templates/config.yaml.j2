# Managed by Ansible - do not edit by hand.
# RKE2 agent configuration for the {{ inventory_hostname }} worker node.

server: "https://{{ master_private_ip }}:9345"
token: "{{ rke2_token }}"

# node-name is pinned explicitly rather than inherited from the OS hostname, so
# the readiness check knows exactly which node object to wait for regardless of
# how cloud-init named the machine.
node-name: "{{ inventory_hostname }}"
node-ip: "{{ node_private_ip }}"

node-label:
  - "platform/managed-by=udap"
  - "platform/role=worker"
